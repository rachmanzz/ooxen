{
  "name": "@rahmantech/ooxen",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.2",
  "description": "Universal bidirectional read-write-render engine for Office Open XML (OOXML)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "keywords": [
    "ooxml",
    "docx",
    "renderer",
    "canvas",
    "html",
    "iso-iec-29500"
  ],
  "author": "Muhammad Abdurrahman",
  "license": "Apache-2.0",
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  }
}
