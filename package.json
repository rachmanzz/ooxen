{
  "name": "@rahmantech/ooxen",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.2.0",
  "description": "Universal bidirectional read-write-render engine for Office Open XML (OOXML)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/renderer/html/ooxen.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./css": "./dist/renderer/html/ooxen.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "audit:validate": "bun scripts/audit/make-sample.ts \"${TMPDIR:-/tmp}/ooxen-audit/sample.docx\" && python3 scripts/audit/validate.py \"${TMPDIR:-/tmp}/ooxen-audit/sample.docx\""
  },
  "keywords": [
    "ooxml",
    "docx",
    "renderer",
    "canvas",
    "html",
    "iso-iec-29500"
  ],
  "author": "Muhammad Abdurrahman",
  "license": "Apache-2.0",
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  }
}
